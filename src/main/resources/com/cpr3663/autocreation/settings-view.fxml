<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane alignment="TOP_CENTER" hgap="15" prefWidth="561.0" vgap="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cpr3663.autocreation.controllers.SettingsController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="120.0" />
        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="250.0" />
    </columnConstraints>

        <!-- Row 0: Page Title -->
        <Label text="Application Settings" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="0">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
            <GridPane.margin>
                <Insets bottom="10" />
            </GridPane.margin>
        </Label>

        <!-- Row 1: Dark Mode -->
        <Label text="Dark Mode:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <CheckBox fx:id="darkModeBox" text="Enable Dark Mode" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Row 2: Robot Repo Path -->
        <Label text="Path to the Robot Code Repo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <HBox alignment="CENTER_LEFT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <TextField fx:id="robotRepoLabel" editable="false" promptText="No folder selected" HBox.hgrow="ALWAYS" />
            <Button onAction="#browseRobotRepo" text="Browse..." />
        </HBox>

        <!-- Row 3: Field Image Path -->
        <Label text="Upload Field Image:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Button onAction="#uploadFieldImage" text="Upload Image" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Row 4: April Tag Field -->
        <Label text="Select an April Tag Field:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="aprilTagDropdown" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Row 5: Action Buttons (Spans across both columns, right-aligned) -->
        <HBox alignment="BOTTOM_RIGHT" spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
            <GridPane.margin>
                <Insets top="20" />
            </GridPane.margin>
                <Button onAction="#cancel" text="Cancel" />
                <Button defaultButton="true" onAction="#save" text="Save Settings" />
        </HBox>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
       <RowConstraints />
       <RowConstraints />
   </rowConstraints>
</GridPane>
