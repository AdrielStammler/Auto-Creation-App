<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<GridPane alignment="TOP_CENTER" hgap="15" vgap="15" xmlns="http://javafx.com/javafx/17.0.12"
          xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cpr3663.autocreation.controllers.SettingsController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT"/>
        <ColumnConstraints halignment="LEFT" prefWidth="325"/>
    </columnConstraints>

    <!-- Row 0: Page Title -->
    <Label text="Application Settings" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="CENTER"
           GridPane.rowIndex="0">
        <font>
            <Font name="System Bold" size="20.0"/>
        </font>
        <GridPane.margin>
            <Insets bottom="10"/>
        </GridPane.margin>
    </Label>

    <!-- Row 1: Dark Mode -->
    <Label text="Dark Mode:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <CheckBox fx:id="darkModeBox" text="Enable Dark Mode" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <!-- Row 2: Robot Repo Path -->
    <Label text="Path to the Robot Code Repo:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <HBox alignment="CENTER_LEFT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
        <TextField fx:id="robotRepoLabel" editable="false" promptText="No folder selected" HBox.hgrow="ALWAYS"/>
        <Button onAction="#browseRobotRepo" text="Browse..."/>
    </HBox>

    <!-- Row 3: Field Image Path -->
    <Label text="Upload Field Image:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <Button onAction="#uploadFieldImage" text="Upload Image" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <!-- Row 4: April Tag Field -->
    <Label text="Select an April Tag Field:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <ComboBox fx:id="aprilTagDropdown" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <!-- Row 5: Default Units -->
    <Label text="Select the Default Units:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
    <ComboBox fx:id="unitsDropDown" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <!-- Row 6: Robot Size (for both x and y) -->
    <Label text="Set the Robot Dimensions:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
    <HBox alignment="CENTER_LEFT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6">
        <Label text="X:"/>
        <TextField fx:id="robotSizeXText" prefWidth="50.0"/>
        <Label text="Y:"/>
        <TextField fx:id="robotSizeYText" prefWidth="50.0"/>
    </HBox>

    <!-- Row 7: -->
    <Label text="Set Field Scale:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
    <TextField fx:id="fieldScaleText" prefWidth="50.0" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

    <!--Row 8: Spacer/Separator -->
    <Separator GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2"/>

    <!-- Row 9: Add Additional Event Types -->
    <Label text="Additional Events:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
    <GridPane prefHeight="125" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="9">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER"/>
            <ColumnConstraints halignment="CENTER"/>
        </columnConstraints>

        <Label text="Events:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ListView fx:id="extraTypesNameList" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <HBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Button onAction="#addName" mnemonicParsing="false" text="Add" />
            <Button onAction="#deleteName" mnemonicParsing="false" text="Delete" />
        </HBox>
        <Label text="Parameters:" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <ListView fx:id="extraTypesParamList" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <HBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Button onAction="#addParam" mnemonicParsing="false" text="Add" />
            <Button onAction="#deleteParam" mnemonicParsing="false" text="Delete" />
        </HBox>
    </GridPane>


    <!-- Row 10: Action Buttons (Spans across both columns, right-aligned) -->
    <HBox alignment="BOTTOM_RIGHT" spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="10">
        <GridPane.margin>
            <Insets top="20"/>
        </GridPane.margin>
        <Button onAction="#cancel" text="Cancel"/>
        <Button defaultButton="true" onAction="#save" text="Save Settings"/>
    </HBox>
</GridPane>
